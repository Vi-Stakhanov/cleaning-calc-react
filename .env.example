# .env.example
# Пример переменных окружения для серверной отправки заявок (api/lead.js).
# Скопируйте этот файл в .env (для локальной проверки) или задайте
# значения в настройках проекта на Vercel. НЕ коммитьте реальные секреты!

# Логин ящика на Яндексе — отправитель писем
SMTP_USER=your-mailbox@yandex.ru

# Пароль приложения для SMTP (создаётся в «Настройки → Пароли приложений»)
SMTP_PASS=xxxxxxxxxxxxxxxx

# Адрес получателя заявок (почта владельца бизнеса)
LEAD_EMAIL=owner@example.com
